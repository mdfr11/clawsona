# Agent brain: dedicated local OpenClaw + the official DeepSeek API.
LLM_PROVIDER=openclaw
DEEPSEEK_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_S=180
LLM_MAX_TOKENS=384
MAX_HISTORY_TURNS=12
OPENCLAW_URL=http://127.0.0.1:18791/v1
OPENCLAW_PROFILE=clawsona
OPENCLAW_AGENT=clawsona
# These local secrets are generated by `clawsona openclaw-setup`.
OPENCLAW_GATEWAY_TOKEN=
CLAWSONA_TOOLS_TOKEN=
CLAWSONA_TOOLS_PORT=18792

STT_PROVIDER=local
TTS_PROVIDER=piper
MODELS_DIR=~/.local/share/clawsona/models
WHISPER_MODEL=small
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=5
# Auto-detect Russian/English per utterance. Use ru or en to force one language.
STT_LANGUAGE=auto
# Optional recognition hints; empty by default.
STT_HOTWORDS=
# Reject uncertain Whisper segments rather than send hallucinations to the model.
STT_MIN_LOGPROB=-1.0
STT_MAX_NO_SPEECH_PROB=0.5
STT_MAX_COMPRESSION_RATIO=2.4
PIPER_VOICE=ru_RU-denis-medium
# English spans use a separate local model, including within a Russian sentence.
PIPER_ENGLISH_VOICE=en_US-ljspeech-medium
# Per-voice terms: setup saves each MODEL_CARD; see docs/THIRD_PARTY_NOTICES.md.

# Optional paid cloud TTS. Uses the existing aiohttp dependency, no extra SDK.
# To enable: TTS_PROVIDER=elevenlabs. The microphone/STT remain local.
# Key permissions: Text to Speech=Access, Voices=Read; all others=No Access.
ELEVENLABS_API_KEY=
# Choose an available voice ID: uv run clawsona elevenlabs-voices
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_TIMEOUT_S=45
# Local RU/EN Piper if the service fails before playback starts.
ELEVENLABS_FALLBACK=true

INPUT_DEVICE=
OUTPUT_DEVICE=
ACTIVATION=name
# Your companion's name, independent of the project/package name.
ASSISTANT_NAME=Мира
# Optional comma-separated spellings, e.g. for English conversations. Empty = none.
ASSISTANT_ALIASES=Mira
# Local Silero speech probability threshold (0..1).
VAD_THRESHOLD=0.6
VAD_MIN_SPEECH_MS=180
# Keep the beginning of a name while VAD confirms speech.
VAD_PRE_ROLL_MS=1000
# End a turn only after this much non-speech; allow pauses while finding words.
# 1800 suits conversation/language practice; 2500 allows longer thinking pauses.
VAD_SILENCE_DURATION_MS=1800
CONVERSATION_TIMEOUT_S=120
# Say the name once, then continue until goodbye or the silence timeout.
FOLLOW_UP_WITHOUT_NAME=true
MAX_UTTERANCE_S=45
AUDIO_READ_TIMEOUT_S=3
LOG_LEVEL=INFO
# Local rotating log: 5 MB per file, 3 backups. Empty disables file logging.
LOG_FILE=logs/clawsona.log
# Opt in to logging recognized text and the actual user text sent to the LLM.
# Timings are logged regardless. OpenClaw separately keeps its session history.
LOG_TRANSCRIPTS=false

# Yandex Music: prefer `clawsona yandex-login`; account tokens stay in a local file.
# An existing personal token can alternatively be supplied here.
MUSIC_ENABLED=false
YANDEX_MUSIC_TOKEN=
MUSIC_VOLUME=50
# Pause music for the whole spoken reply; preserve explicit user pause/stop.
MUSIC_PAUSE_DURING_SPEECH=true

# Optional direct-model mode without OpenClaw/tools:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
# Offline LLM: LLM_PROVIDER=ollama, LLM_MODEL=qwen2.5:3b
# Optional cloud speech: `uv sync --extra cloud-speech`
# STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# TTS_PROVIDER=edge
# TTS_VOICE=ru-RU-DmitryNeural
